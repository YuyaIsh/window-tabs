{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "window-tabs",
  "version": "0.1.1",
  "identifier": "io.github.yuyaish.window-tabs",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [{ "title": "window-tabs controller", "width": 720, "height": 640, "resizable": false, "decorations": false, "alwaysOnTop": false, "skipTaskbar": true, "visible": false }],
    "security": { "capabilities": ["main", "group-hosts"] }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY_BEFORE_RELEASE",
      "endpoints": ["https://github.com/YuyaIsh/window-tabs/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
